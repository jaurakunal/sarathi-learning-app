# Copy to .env.local and fill in the values from your own deployed stack
# (see the CloudFormation outputs of `cdk deploy`).
VITE_API_URL=http://localhost:3001
VITE_APPSYNC_URL=http://localhost:4000/graphql
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_COGNITO_DOMAIN=your-domain-prefix.auth.us-east-1.amazoncognito.com
VITE_REDIRECT_URI=http://localhost:3000/callback
VITE_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
